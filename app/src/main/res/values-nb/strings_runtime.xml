<?xml version="1.0" encoding="utf-8"?>
<!-- Texts of the background part (presence service, notifications, %status% in the presence). -->
<resources>
    <!-- %status% placeholder / small image text in Discord -->
    <string name="status_playing">Spiller</string>
    <string name="status_paused">Satt på pause</string>
    <string name="status_test_line">Tilkoblingen fungerer!</string>

    <!-- Notification channels -->
    <string name="svc_channel_name">Discord-status</string>
    <string name="svc_channel_desc">Vises mens appen holder Discord-statusen din synkronisert med Poweramp</string>
    <string name="svc_alert_channel_name">Varsler om problemer</string>
    <string name="svc_alert_channel_desc">Problemer som krever oppmerksomheten din, f.eks. når Android blokkerer oppstart i bakgrunnen</string>

    <!-- Presence service notification: title = what plays, text = what Discord shows / the connection state -->
    <string name="svc_track">%1$s – %2$s</string>
    <string name="svc_showing">Vises på Discord</string>
    <string name="svc_showing_paused">Satt på pause – vises på Discord</string>
    <string name="svc_hidden_paused">Satt på pause – skjult på Discord</string>
    <string name="svc_hidden">Ingenting vises på Discord</string>
    <string name="svc_testing">Testvisning vises på Discord</string>
    <string name="svc_sending">Sender til Discord …</string>
    <string name="svc_update_rejected">Discord godtok ikke statusen – detaljer i appen</string>
    <string name="svc_connecting">Kobler til Discord …</string>
    <string name="svc_waiting">Venter på Poweramp …</string>
    <string name="svc_not_connected">Ikke koblet til Discord – prøver igjen</string>
    <string name="svc_discord_missing">Discord-appen er ikke installert</string>
    <string name="svc_rejected">Discord avviste applikasjons-ID-en</string>
    <string name="svc_no_app_id">Ingen Discord-applikasjons-ID er angitt</string>
    <string name="svc_disabled">Discord Rich Presence er slått av</string>
    <string name="svc_action_stop">Stopp</string>

    <!-- Android refused to start the service in the background -->
    <string name="svc_bg_blocked_title">Discord-statusen kunne ikke starte</string>
    <string name="svc_bg_blocked_text">Android lar ikke appen starte i bakgrunnen. Trykk for å åpne appen og la den kjøre i bakgrunnen (batterioptimalisering).</string>

    <string name="svc_track">%1$s – %2$s</string>
    <string name="svc_showing">正在 Discord 上显示</string>
    <string name="svc_showing_paused">已暂停，在 Discord 上显示</string>
    <string name="svc_hidden_paused">已暂停，在 Discord 上隐藏</string>
    <string name="svc_hidden">Discord 上不显示任何内容</string>
    <string name="svc_testing">Discord 上正在显示测试状态</string>
    <string name="svc_sending">正在发送到 Discord…</string>
    <string name="svc_update_rejected">Discord 未接受此状态，详情请见应用</string>
    <string name="svc_connecting">正在连接 Discord…</string>
    <string name="svc_waiting">正在等待 Poweramp…</string>
    <string name="svc_not_connected">未连接到 Discord，正在重试</string>
    <string name="svc_discord_missing">未安装 Discord 应用</string>
    <string name="svc_rejected">Discord 拒绝了应用 ID</string>

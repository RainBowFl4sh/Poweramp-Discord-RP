<?xml version="1.0" encoding="utf-8"?>
<!-- Texts of the background part (presence service, notifications, %status% in the presence). -->
<resources>
    <!-- %status% placeholder / small image text in Discord -->
    <string name="status_playing">Spelar</string>
    <string name="status_paused">Pausad</string>
    <string name="status_test_line">Anslutningen fungerar!</string>

    <!-- Notification channels -->
    <string name="svc_channel_name">Discord-närvaro</string>
    <string name="svc_channel_desc">Visas medan appen håller din Discord-status synkad med Poweramp</string>

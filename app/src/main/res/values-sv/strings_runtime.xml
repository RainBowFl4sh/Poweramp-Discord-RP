    <string name="svc_testing">Testnärvaro visas i Discord</string>
    <string name="svc_sending">Skickar till Discord…</string>
    <string name="svc_update_rejected">Discord godtog inte närvaron – detaljer i appen</string>
    <string name="svc_connecting">Ansluter till Discord…</string>
    <string name="svc_waiting">Väntar på Poweramp…</string>
    <string name="svc_not_connected">Inte ansluten till Discord – försöker igen</string>
    <string name="svc_discord_missing">Discord-appen är inte installerad</string>
    <string name="svc_rejected">Discord avvisade applikations-ID:t</string>

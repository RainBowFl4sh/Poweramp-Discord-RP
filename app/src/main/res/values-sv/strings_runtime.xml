    <string name="svc_alert_channel_desc">Problem som kräver din uppmärksamhet, t.ex. när Android blockerar start i bakgrunden</string>

    <!-- Presence service notification: title = what plays, text = what Discord shows / the connection state -->
    <string name="svc_track">%1$s – %2$s</string>
    <string name="svc_showing">Visas i Discord</string>
    <string name="svc_showing_paused">Pausad – visas i Discord</string>

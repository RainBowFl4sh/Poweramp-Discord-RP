    <string name="svc_disabled">Discord Rich Presence är avstängt</string>
    <string name="svc_action_stop">Stoppa</string>

    <!-- Android refused to start the service in the background -->
    <string name="svc_bg_blocked_title">Discord-närvaron kunde inte starta</string>
    <string name="svc_bg_blocked_text">Android låter inte appen starta i bakgrunden. Tryck för att öppna appen och tillåt att den körs i bakgrunden (batterioptimering).</string>

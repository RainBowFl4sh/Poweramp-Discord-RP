<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon background, in the style of Poweramp's icon: black, a dark disc (r 30.6) with a thin periwinkle
     rim and a short periwinkle glow just outside it. The in-app logo (AppLogo) draws it without the black "backdrop",
     so the glow fades into the screen behind it, like in Poweramp's raster icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:name="backdrop"
        android:fillColor="#FF000000"
        android:pathData="M0,0h108v108h-108z" />
    <!-- glow: fades out from the disc edge (r 30.6) to r 34; the mask edge (r 36) stays black -->
    <path android:pathData="M54,20A34,34 0,1 1 54,88A34,34 0,1 1 54,20Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:offset="0" android:color="#009DB9FF" />
                <item android:offset="0.891" android:color="#009DB9FF" />
                <item android:offset="0.9" android:color="#A69DB9FF" />
                <item android:offset="0.941" android:color="#409DB9FF" />
                <item android:offset="1" android:color="#009DB9FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- disc (r 30.6) with a 1.7 dp rim at 65%, like Poweramp's adaptive icon: almost black in the upper middle,
         lighter navy towards the edge and the bottom -->
    <path
        android:pathData="M54,23.4A30.6,30.6 0,1 1 54,84.6A30.6,30.6 0,1 1 54,23.4Z"
        android:strokeColor="#FF9DB9FF"
        android:strokeAlpha="0.65"
        android:strokeWidth="1.7">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="40"
                android:gradientRadius="46">
                <item android:offset="0" android:color="#FF0C0C10" />
                <item android:offset="0.4" android:color="#FF0D0E16" />
                <item android:offset="0.75" android:color="#FF141620" />
                <item android:offset="1" android:color="#FF1F222D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

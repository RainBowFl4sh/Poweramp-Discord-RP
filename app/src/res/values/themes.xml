<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window themes of the Compose activity; the content itself is themed by Compose / Material 3 (light / dark,
         AMOLED black, dynamic color as the app settings say). The splash screen of Android 12+ uses the icon's black,
         so the disc with its blue rim sits on a matching background (like Poweramp's) in light and dark mode. -->
    <color name="window_light">#FFFBF8FF</color>
    <color name="window_dark">#FF131318</color>

    <!-- What Android shows before the app runs: follows the system's night mode (values-night) -->
    <style name="Theme.PowerampDiscordRP" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#FF000000</item>
    </style>

    <!-- MainActivity picks one of these before its first frame, as the app's theme setting says -->
    <style name="Theme.PowerampDiscordRP.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#FF000000</item>
    </style>

    <style name="Theme.PowerampDiscordRP.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#FF000000</item>
    </style>
</resources>

<!-- Texts of the background part (presence service, notifications, %status% in the presence). -->
<resources>
    <!-- %status% placeholder / small image text in Discord -->
    <string name="status_playing">Playing</string>
    <string name="status_paused">Paused</string>
    <string name="status_test_line">The connection works!</string>

